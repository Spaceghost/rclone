diff --git a/fs/atomic_commit.go b/fs/atomic_commit.go
new file mode 100644
index 0000000..69aa429
--- /dev/null
+++ b/fs/atomic_commit.go
@@ -0,0 +1,30 @@
+package fs
+
+import (
+	"context"
+	"errors"
+)
+
+var (
+	// ErrorCantAtomicCommit is returned when atomic commit is unavailable.
+	ErrorCantAtomicCommit = errors.New("atomic commit not available")
+	// ErrorAtomicCommitConflict is returned when the destination changed after
+	// preparation.
+	ErrorAtomicCommitConflict = errors.New("atomic commit conflict")
+)
+
+// AtomicCommit represents a prepared conditional replacement.
+type AtomicCommit interface {
+	// Commit atomically replaces the prepared destination with srcRemote.
+	Commit(ctx context.Context, srcRemote string) error
+	// Close releases resources held by the prepared commit.
+	Close() error
+}
+
+// AtomicCommitter is an optional interface for filesystems which can prepare
+// an atomic replacement guarded against concurrent modification.
+type AtomicCommitter interface {
+	// StartAtomicCommit samples the current state of remote for a later commit.
+	// It returns ErrorCantAtomicCommit when the operation is not available.
+	StartAtomicCommit(ctx context.Context, remote string) (AtomicCommit, error)
+}
