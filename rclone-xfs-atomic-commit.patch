diff --git a/backend/local/atomic_commit_linux.go b/backend/local/atomic_commit_linux.go
new file mode 100644
index 0000000..989f4fe
--- /dev/null
+++ b/backend/local/atomic_commit_linux.go
@@ -0,0 +1,153 @@
+//go:build linux
+
+package local
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"unsafe"
+
+	"github.com/rclone/rclone/fs"
+	"golang.org/x/sys/unix"
+)
+
+const (
+	xfsSuperMagic = 0x58465342
+
+	xfsExchangeRangeToEOF = 1 << 0
+	xfsExchangeRangeDsync = 1 << 1
+
+	// _IOR('X', 130, struct xfs_commit_range)
+	xfsIOCStartCommit = 0x80505882
+	// _IOW('X', 131, struct xfs_commit_range)
+	xfsIOCCommitRange = 0x40505883
+)
+
+type xfsCommitRange struct {
+	File1Fd        int32
+	Pad            uint32
+	File1Offset    uint64
+	File2Offset    uint64
+	Length         uint64
+	Flags          uint64
+	File2Freshness [5]uint64
+}
+
+type xfsAtomicCommit struct {
+	dst  *os.File
+	args xfsCommitRange
+	f    *Fs
+}
+
+func xfsIoctl(fd uintptr, req uintptr, arg *xfsCommitRange) error {
+	_, _, errno := unix.Syscall(unix.SYS_IOCTL, fd, req, uintptr(unsafe.Pointer(arg)))
+	if errno != 0 {
+		return errno
+	}
+	return nil
+}
+
+func isXFS(file *os.File) (bool, error) {
+	var stat unix.Statfs_t
+	if err := unix.Fstatfs(int(file.Fd()), &stat); err != nil {
+		return false, err
+	}
+	return uint64(stat.Type) == xfsSuperMagic, nil
+}
+
+// StartAtomicCommit prepares an XFS conditional range commit for remote.
+func (f *Fs) StartAtomicCommit(ctx context.Context, remote string) (fs.AtomicCommit, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+
+	dstObj, err := f.newObject(remote)
+	if err != nil {
+		return nil, err
+	}
+	dst, err := os.OpenFile(dstObj.path, os.O_RDWR, 0)
+	if os.IsNotExist(err) {
+		return nil, fs.ErrorCantAtomicCommit
+	}
+	if err != nil {
+		return nil, err
+	}
+
+	closeOnError := func(err error) (fs.AtomicCommit, error) {
+		_ = dst.Close()
+		return nil, err
+	}
+
+	xfs, err := isXFS(dst)
+	if err != nil {
+		return closeOnError(err)
+	}
+	if !xfs {
+		return closeOnError(fs.ErrorCantAtomicCommit)
+	}
+
+	commit := &xfsAtomicCommit{dst: dst, f: f}
+	if err := xfsIoctl(dst.Fd(), xfsIOCStartCommit, &commit.args); err != nil {
+		if errors.Is(err, unix.ENOTTY) || errors.Is(err, unix.EOPNOTSUPP) || errors.Is(err, unix.EINVAL) {
+			return closeOnError(fs.ErrorCantAtomicCommit)
+		}
+		return closeOnError(fmt.Errorf("XFS_IOC_START_COMMIT: %w", err))
+	}
+	return commit, nil
+}
+
+// Commit atomically exchanges srcRemote with the prepared destination if the
+// destination has not changed since StartAtomicCommit.
+func (c *xfsAtomicCommit) Commit(ctx context.Context, srcRemote string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if c.dst == nil {
+		return os.ErrClosed
+	}
+
+	srcObj, err := c.f.newObject(srcRemote)
+	if err != nil {
+		return err
+	}
+	src, err := os.OpenFile(srcObj.path, os.O_RDWR, 0)
+	if err != nil {
+		return err
+	}
+	defer func() {
+		_ = src.Close()
+	}()
+
+	xfs, statErr := isXFS(src)
+	if statErr != nil {
+		return statErr
+	}
+	if !xfs {
+		return fs.ErrorCantAtomicCommit
+	}
+
+	c.args.File1Fd = int32(src.Fd())
+	c.args.Flags = xfsExchangeRangeToEOF | xfsExchangeRangeDsync
+	if err := xfsIoctl(c.dst.Fd(), xfsIOCCommitRange, &c.args); err != nil {
+		if errors.Is(err, unix.EBUSY) {
+			return fs.ErrorAtomicCommitConflict
+		}
+		if errors.Is(err, unix.ENOTTY) || errors.Is(err, unix.EOPNOTSUPP) || errors.Is(err, unix.EINVAL) || errors.Is(err, unix.EXDEV) {
+			return fs.ErrorCantAtomicCommit
+		}
+		return fmt.Errorf("XFS_IOC_COMMIT_RANGE: %w", err)
+	}
+	return nil
+}
+
+// Close releases the destination descriptor held by the prepared commit.
+func (c *xfsAtomicCommit) Close() error {
+	if c.dst == nil {
+		return nil
+	}
+	err := c.dst.Close()
+	c.dst = nil
+	return err
+}
