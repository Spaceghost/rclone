 	StartAtomicCommit(ctx context.Context, remote string) (AtomicCommit, error)
 }
+
+// AtomicCreator is an optional interface for filesystems which can publish a
+// staged object without replacing an existing destination.
+type AtomicCreator interface {
+	// AtomicCreate moves srcRemote to dstRemote only when dstRemote is absent.
+	// It returns ErrorAtomicCommitConflict when dstRemote already exists.
+	AtomicCreate(ctx context.Context, srcRemote, dstRemote string) error
+}
