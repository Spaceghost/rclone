+// AtomicCreate moves srcRemote to dstRemote only if dstRemote does not exist.
+func (f *Fs) AtomicCreate(ctx context.Context, srcRemote, dstRemote string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	srcObj, err := f.newObject(srcRemote)
+	if err != nil {
+		return err
+	}
+	dstObj, err := f.newObject(dstRemote)
+	if err != nil {
+		return err
+	}
+	err = unix.Renameat2(unix.AT_FDCWD, srcObj.path, unix.AT_FDCWD, dstObj.path, unix.RENAME_NOREPLACE)
+	if err == nil {
+		return nil
+	}
+	if errors.Is(err, unix.EEXIST) {
+		return fs.ErrorAtomicCommitConflict
+	}
+	if errors.Is(err, unix.ENOSYS) || errors.Is(err, unix.EINVAL) || errors.Is(err, unix.EOPNOTSUPP) || errors.Is(err, unix.EXDEV) {
+		return fs.ErrorCantAtomicCommit
+	}
+	return err
+}
